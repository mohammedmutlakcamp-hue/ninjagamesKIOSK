# Per user request: ONLY environment/secret files are ignored.
# Everything else (node_modules, .next, client/, bin/, obj/) is committed.
.env
.env.local
.env.*.local
server/.env
server/.env.local
server/.env.*.local

# OS / IDE noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
.gemini/

# GitHub rejects files > 100 MB. These are all rebuild artifacts:
# (regenerated by npm install / npm run build / dotnet build)
server/.next/cache/
server/kiosk/
*.pack
*.log

# Large binary files that exceed GitHub's 100MB limit
server/node_modules/@next/swc-win32-x64-msvc/next-swc.win32-x64-msvc.node
