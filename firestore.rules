// ==============================================================================
// NinjaKiosk — Firestore rules: ALLOW EVERYTHING
// ==============================================================================
// Single rule, no auth required. Every collection (existing or future) is
// readable + writable. No more "I added a new feature and writes silently
// fail because the path isn't in the rules" headaches.
//
// Deploy with:    firebase deploy --only firestore:rules
// ==============================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
